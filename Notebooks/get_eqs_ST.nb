           RowBox[{"pi5", "[", "]"}]}], "}"}], ",", 
         RowBox[{"MetricOn", "\[Rule]", "All"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tmp", "=", 
      RowBox[{"tmp", "//.", 
       RowBox[{"MakeRule", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"RicciCD", "[", 
             RowBox[{
              RowBox[{"-", "\[Alpha]"}], ",", 
              RowBox[{"-", "\[Beta]"}]}], "]"}], " ", 
            RowBox[{
             RowBox[{"CD", "[", "\[Alpha]", "]"}], "@", 
