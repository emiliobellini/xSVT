Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{"runEQmetric", ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tmp", "=", 
      RowBox[{"tmpL", " ", "//", " ", "XcovToScalarcov"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tmp", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], " ", 
        RowBox[{
         RowBox[{
          RowBox[{"VarD", "[", 
           RowBox[{
            RowBox[{"pertmetricg", "[", 
             RowBox[{
              RowBox[{"LI", "[", "1", "]"}], ",", "\[Mu]", ",", "\[Nu]"}], 
             "]"}], ",", "CD"}], "]"}], "[", "tmp", "]"}], "/", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"-", 
           RowBox[{"Detmetricg", "[", "]"}]}], "]"}]}]}], " ", "//.", 
       RowBox[{
        RowBox[{"delta", "[", 
