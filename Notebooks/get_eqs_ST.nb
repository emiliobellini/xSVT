Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{"rundecompositionrules", ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"SVTDecomposition", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"CD", "[", 
         RowBox[{"-", "\[Mu]"}], "]"}], "@", 
        RowBox[{
         RowBox[{"CD", "[", 
          RowBox[{"-", "\[Nu]"}], "]"}], "@", 
         RowBox[{"scalarcov", "[", "]"}]}]}], ",", "order", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Mu]", "->", "a"}], ",", 
         RowBox[{"\[Nu]", "\[Rule]", "i"}]}], "}"}], ",", 
       RowBox[{"StoreName", "\[Rule]", 
        RowBox[{"pertddpi", "[", 
         RowBox[{
          RowBox[{"LI", "[", "order", "]"}], ",", 
          RowBox[{"-", "a"}], ",", 
          RowBox[{"-", "i"}]}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"tmp", "=", 
      RowBox[{
       RowBox[{"pertddpi", "[", 
        RowBox[{
         RowBox[{"LI", "[", "order", "]"}], ",", 
         RowBox[{"-", "a"}], ",", 
         RowBox[{"-", "i"}]}], "]"}], " ", "//.", 
       RowBox[{"$SVTDecompositionRules", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"$SVTDecompositionRules", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "=", 
      RowBox[{"Union", "[", 
       RowBox[{
        RowBox[{"$SVTDecompositionRules", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", "\n", "\t", 
        RowBox[{"MakeRule", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"pertddpi", "[", 
            RowBox[{
             RowBox[{"LI", "[", "order", "]"}], ",", 
             RowBox[{"-", "i"}], ",", 
             RowBox[{"-", "a"}]}], "]"}], ",", 
           RowBox[{"Evaluate", "[", "tmp", "]"}]}], "}"}], "]"}]}], "]"}]}], 
     ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]], "Input",
