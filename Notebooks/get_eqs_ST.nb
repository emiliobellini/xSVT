Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{"runthirdmetric", ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tmp", "=", 
      RowBox[{
       RowBox[{"EQmetric", " ", "//.", "$StressEnergyDecomposition"}], " ", "//",
        "ContractMetric"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tmp", "=", 
      RowBox[{"tmp", "//.", 
       RowBox[{"MakeRule", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"CD", "[", 
              RowBox[{"-", "\[Alpha]"}], "]"}], "@", 
             RowBox[{"scalarcov", "[", "]"}]}], " ", 
            RowBox[{
             RowBox[{"CD", "[", "\[Alpha]", "]"}], "@", 
             RowBox[{"scalarcov", "[", "]"}]}]}], ",", 
           RowBox[{
            RowBox[{"-", "2"}], " ", 
            RowBox[{"piX", "[", "]"}]}]}], "}"}], ",", 
         RowBox[{"MetricOn", "\[Rule]", "All"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tmp", "=", 
      RowBox[{"tmp", "//.", 
       RowBox[{
        RowBox[{"RicciScalarCD", "[", "]"}], "\[RuleDelayed]", 
        RowBox[{"RicciScalarCDP", "[", "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tmp", "=", 
      RowBox[{"tmp", "//.", 
