               RowBox[{"tmp2", " ", "//.", 
                RowBox[{
                 RowBox[{"-", "i"}], "->", 
                 RowBox[{"-", "j"}]}]}], "]"}]}]}], ")"}], "/", 
           RowBox[{"(", 
