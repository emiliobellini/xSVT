Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{"runthirdmetric", ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tmp", "=", 
      RowBox[{
       RowBox[{"EQmetric", " ", "//.", "$StressEnergyDecomposition"}], " ", "//",
        "ContractMetric"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tmp", "=", 
      RowBox[{"tmp", "//.", 
       RowBox[{"MakeRule", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"CD", "[", 
              RowBox[{"-", "\[Alpha]"}], "]"}], "@", 
             RowBox[{"scalarcov", "[", "]"}]}], " ", 
            RowBox[{
             RowBox[{"CD", "[", "\[Alpha]", "]"}], "@", 
             RowBox[{"scalarcov", "[", "]"}]}]}], ",", 
           RowBox[{
            RowBox[{"-", "2"}], " ", 
            RowBox[{"piX", "[", "]"}]}]}], "}"}], ",", 
         RowBox[{"MetricOn", "\[Rule]", "All"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tmp", "=", 
      RowBox[{"tmp", "//.", 
       RowBox[{
        RowBox[{"RicciScalarCD", "[", "]"}], "\[RuleDelayed]", 
        RowBox[{"RicciScalarCDP", "[", "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tmp", "=", 
      RowBox[{"tmp", "//.", 
       RowBox[{"MakeRule", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"CD", "[", 
             RowBox[{"-", "\[Mu]"}], "]"}], "@", 
            RowBox[{
             RowBox[{"CD", "[", "\[Mu]", "]"}], "@", 
             RowBox[{"scalarcov", "[", "]"}]}]}], ",", 
           RowBox[{"pi1", "[", "]"}]}], "}"}], ",", 
         RowBox[{"MetricOn", "\[Rule]", "All"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tmp", "=", 
      RowBox[{"tmp", "//.", 
       RowBox[{"MakeRule", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"CD", "[", 
              RowBox[{"-", "\[Mu]"}], "]"}], "@", 
             RowBox[{
              RowBox[{"CD", "[", 
               RowBox[{"-", "\[Nu]"}], "]"}], "@", 
              RowBox[{"scalarcov", "[", "]"}]}]}], " ", 
            RowBox[{
             RowBox[{"CD", "[", "\[Mu]", "]"}], "@", 
             RowBox[{
              RowBox[{"CD", "[", "\[Nu]", "]"}], "@", 
              RowBox[{"scalarcov", "[", "]"}]}]}]}], ",", 
           RowBox[{"pi2", "[", "]"}]}], "}"}], ",", 
         RowBox[{"MetricOn", "\[Rule]", "All"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tmp", "=", 
      RowBox[{"tmp", "//.", 
       RowBox[{"MakeRule", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"CD", "[", 
              RowBox[{"-", "\[Beta]"}], "]"}], "@", 
             RowBox[{
              RowBox[{"CD", "[", "\[Alpha]", "]"}], "@", 
              RowBox[{"scalarcov", "[", "]"}]}]}], " ", 
            RowBox[{
             RowBox[{"CD", "[", 
              RowBox[{"-", "\[Eta]"}], "]"}], "@", 
             RowBox[{
              RowBox[{"CD", "[", "\[Beta]", "]"}], "@", 
              RowBox[{"scalarcov", "[", "]"}]}]}], " ", 
            RowBox[{
             RowBox[{"CD", "[", "\[Eta]", "]"}], "@", 
