Cell[BoxData[
 RowBox[{"(*", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"GetHigherOrderAlpha", "[", 
     RowBox[{"expr_", ",", "exp_", ",", "rule_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"tmp", ",", "der1", ",", "der2"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"tmp", "=", 
         RowBox[{
          RowBox[{"expr", "/", 
           RowBox[{
            RowBox[{"X", "[", "]"}], "^", "exp"}]}], " ", "//", " ", 
          "Expand"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"tmp", "=", 
         RowBox[{"tmp", " ", "//.", 
          RowBox[{
           RowBox[{"pprimescalar", "[", "]"}], ":>", 
           RowBox[{
            RowBox[{
             RowBox[{"hubbleC", "[", "]"}], " ", 
             RowBox[{"primescalar", "[", "]"}]}], "+", 
            RowBox[{
             RowBox[{
              RowBox[{"scale", "[", "]"}], "^", "2"}], " ", 
             RowBox[{
              RowBox[{"primeX", "[", "]"}], "/", 
              RowBox[{"primescalar", "[", "]"}]}]}]}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"tmp", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"tmp", " ", "//.", "invSubX0"}], " ", "//.", 
           RowBox[{
            RowBox[{"primescalar", "[", "]"}], ":>", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"2", " ", 
              RowBox[{
               RowBox[{"scale", "[", "]"}], "^", "2"}], " ", 
              RowBox[{"X", "[", "]"}]}], "]"}]}]}], " ", "//", " ", 
          "Expand"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"der1", "=", 
         RowBox[{"D", "[", 
          RowBox[{"tmp", ",", 
           RowBox[{"X", "[", "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"der2", "=", 
         RowBox[{"D", "[", 
          RowBox[{"tmp", ",", 
           RowBox[{"primeX", "[", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"tmp", "=", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             RowBox[{
              RowBox[{"X", "[", "]"}], "^", 
              RowBox[{"(", 
               RowBox[{"exp", "+", "1"}], ")"}]}]}], "/", "exp"}], " ", 
           RowBox[{"(", 
            RowBox[{"der1", "-", 
             RowBox[{"TimeDer", "[", "der2", "]"}]}], ")"}]}], " ", "//", " ",
           "Expand"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"tmp", "=", 
         RowBox[{"tmp", " ", "//.", 
          RowBox[{
           RowBox[{"primeX", "[", "]"}], ":>", 
           RowBox[{
            RowBox[{"primescalar", "[", "]"}], " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"pprimescalar", "[", "]"}], "-", 
               RowBox[{
                RowBox[{"hubbleC", "[", "]"}], " ", 
                RowBox[{"primescalar", "[", "]"}]}]}], ")"}], "/", 
             RowBox[{
              RowBox[{"scale", "[", "]"}], "^", "2"}]}]}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"tmp", "=", 
         RowBox[{
          RowBox[{"tmp", " ", "//.", "SubX0"}], " ", "//.", "restoreXinG"}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"tmp", "=", 
         RowBox[{
          RowBox[{"Simplify", "[", 
           RowBox[{"tmp", ",", 
            RowBox[{"Assumptions", "->", 
             RowBox[{
              RowBox[{"primescalar", "[", "]"}], ">", "0"}]}]}], "]"}], " ", "//",
           " ", "Expand"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"tmp", "=", 
         RowBox[{"tmp", " ", "//.", "rule"}]}], ";", "\[IndentingNewLine]", 
        "tmp"}]}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
     RowBox[{"EQalphaK2", "=", 
      RowBox[{"GetHigherOrderAlpha", "[", 
       RowBox[{"EQalphaK", ",", "1", ",", 
        RowBox[{
         RowBox[{"alphaK", "[", "]"}], "->", 
         RowBox[{"alphaK2", "[", "]"}]}]}], "]"}]}]}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"EQalphaB2", "=", 
    RowBox[{"GetHigherOrderAlpha", "[", 
     RowBox[{"EQalphaB", ",", 
      RowBox[{"3", "/", "2"}], ",", 
      RowBox[{
       RowBox[{"alphaB", "[", "]"}], "->", 
       RowBox[{"alphaB2", "[", "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"EQalphaT2", "=", 
    RowBox[{
     RowBox[{"GetHigherOrderAlpha", "[", 
      RowBox[{"EQalphaT", ",", "1", ",", 
       RowBox[{
        RowBox[{"alphaT", "[", "]"}], "->", 
        RowBox[{"alphaT2", "[", "]"}]}]}], "]"}], "-", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"3", " ", 
          RowBox[{"pprimescalar", "[", "]"}]}], "+", 
         RowBox[{"4", " ", 
          RowBox[{"hubbleC", "[", "]"}], " ", 
          RowBox[{"primescalar", "[", "]"}]}]}], ")"}], "/", "6"}], " ", 
      RowBox[{
       RowBox[{
        RowBox[{"primescalar", "[", "]"}], "^", "2"}], "/", 
       RowBox[{
        RowBox[{"scale", "[", "]"}], "^", "4"}]}], " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Derivative", "[", 
         RowBox[{"0", ",", "1"}], "]"}], "[", "G5fun", "]"}], "[", 
       RowBox[{
        RowBox[{"scalar", "[", "]"}], ",", 
        RowBox[{"X", "[", "]"}]}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"EQalphaM2", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"GetHigherOrderAlpha", "[", 
        RowBox[{"EQprimemass2", ",", 
         RowBox[{"1", "/", "2"}], ",", 
         RowBox[{
          RowBox[{"alphaM", "[", "]"}], "->", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"hubbleC", "[", "]"}], "^", "2"}], "-", 
              RowBox[{"primehubbleC", "[", "]"}]}], ")"}], "/", 
            RowBox[{
             RowBox[{"scale", "[", "]"}], "^", "2"}]}], " ", 
           RowBox[{"alphaM2", "[", "]"}]}]}]}], "]"}], " ", 
       RowBox[{
        RowBox[{"scale", "[", "]"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"hubbleC", "[", "]"}], "^", "2"}], "-", 
          RowBox[{"primehubbleC", "[", "]"}]}], ")"}]}]}], " ", "//", " ", 
      "Simplify"}], " ", "//", " ", "Expand"}]}], ";", "\[IndentingNewLine]", 
   
   RowBox[{"EQalphaH2", "=", 
    RowBox[{"GetHigherOrderAlpha", "[", 
     RowBox[{"EQalphaH", ",", "2", ",", 
      RowBox[{
       RowBox[{"alphaH", "[", "]"}], "->", 
       RowBox[{"alphaH2", "[", "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "*)"}]], "Input",
 CellChangeTimes->{{3.941277828842515*^9, 3.941277830007503*^9}, {
  3.941278091693519*^9, 3.941278096762494*^9}, {3.941283655765963*^9, 
  3.941283657584248*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"5132173d-fc8e-40ec-865f-a6c6e67d0e92"],

