Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"runEQmetric", " ", "||", " ", "runEQscalar"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tmp", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Lgravity", "+", "Lmatter"}], " ", "//", " ", 
         RowBox[{"SeparateMetric", "[", "]"}]}], " ", "//", " ", 
        "ToCanonical"}], " ", "//", " ", "ReplaceDummies"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tmpL", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"ExpandPerturbation", "[", 
          RowBox[{"Perturbation", "[", 
           RowBox[{
            RowBox[{"tmp", " ", "//", " ", "XcovToScalarcov"}], ",", "1"}], 
           "]"}], "]"}], " ", "//", " ", "ScalarcovToXcov"}], " ", "//", " ", 
        "NoScalar"}], " ", "//", " ", "ToCanonical"}]}], ";"}]}], 
   "\[IndentingNewLine]", "]"}], ";"}]], "Input",
