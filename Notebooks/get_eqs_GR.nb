Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{"runEQgaugethirdHij", ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time", ",", "tmp"}], "}"}], "=", 
      RowBox[{"Timing", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"metric\[Delta]", "[", 
            RowBox[{
             RowBox[{"-", "i"}], ",", 
             RowBox[{"-", "j"}]}], "]"}], " ", 
           RowBox[{"metric\[Delta]", "[", 
            RowBox[{"k", ",", "l"}], "]"}], " ", 
           RowBox[{
            RowBox[{"PD", "[", 
             RowBox[{"-", "k"}], "]"}], "@", 
            RowBox[{
             RowBox[{"PD", "[", 
              RowBox[{"-", "l"}], "]"}], "@", "#"}]}]}], " ", "&"}], ",", 
         "tmp1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Time: \>\"", "<>", 
       RowBox[{"ToString", "@", "time"}], "<>", "\"\< sec. Elements: \>\"", "<>", 
       RowBox[{"ToString", "@", 
        RowBox[{"Length", "@", "tmp"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time", ",", "tmp"}], "}"}], "=", 
      RowBox[{"Timing", "[", 
       RowBox[{"Listify", "[", 
        RowBox[{"SVTExpand", ",", "tmp", ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"ListMethod", "\[Rule]", "\"\<SamePerts\>\""}], ",", 
         RowBox[{"Verbose", "\[Rule]", "True"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Time: \>\"", "<>", 
       RowBox[{"ToString", "@", "time"}], "<>", "\"\< sec. Elements: \>\"", "<>", 
       RowBox[{"ToString", "@", 
        RowBox[{"Length", "@", "tmp"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"mijtmp1", "=", 
      RowBox[{"tmp", " ", "//", " ", "ReplaceDummies"}]}], ";"}]}], 
   "\[IndentingNewLine]", "]"}], ";"}]], "Input",
