          RowBox[{"-", "j"}], ",", 
          RowBox[{"-", "k"}]}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"tmp", "=", 
      RowBox[{
       RowBox[{"RiemannCDP", "[", 
