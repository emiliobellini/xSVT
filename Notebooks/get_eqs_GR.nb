Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"RunIf", "[", 
   RowBox[{"$RunSecondOrder", ",", 
    RowBox[{"{", "EQsecmetricij", "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"EQsec6", ",", "EQsource6"}], "}"}], ",", "\[IndentingNewLine]", 
    
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time", ",", "tmp1"}], "}"}], "=", 
      RowBox[{"Timing", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"4", " ", "#"}], " ", "&"}], ",", "lapdiv"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Time: \>\"", "<>", 
       RowBox[{"ToString", "@", "time"}], "<>", "\"\< sec. Elements: \>\"", "<>", 
       RowBox[{"ToString", "@", 
        RowBox[{"Length", "@", "tmp1"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time", ",", "tmp2"}], "}"}], "=", 
      RowBox[{"Timing", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"-", "4"}], " ", "#"}], " ", "&"}], ",", "graddivdiv"}], 
        "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Time: \>\"", "<>", 
       RowBox[{"ToString", "@", "time"}], "<>", "\"\< sec. Elements: \>\"", "<>", 
       RowBox[{"ToString", "@", 
        RowBox[{"Length", "@", "tmp2"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time", ",", "tmp"}], "}"}], "=", 
      RowBox[{"Timing", "[", 
       RowBox[{"Listify", "[", 
        RowBox[{"Expand", ",", 
         RowBox[{"tmp1", "+", "tmp2"}], ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"ListMethod", "\[Rule]", "\"\<SamePerts\>\""}], ",", 
         RowBox[{"Verbose", "\[Rule]", "True"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Time: \>\"", "<>", 
       RowBox[{"ToString", "@", "time"}], "<>", "\"\< sec. Elements: \>\"", "<>", 
       RowBox[{"ToString", "@", 
        RowBox[{"Length", "@", "tmp"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time", ",", "EQsec6"}], "}"}], "=", 
      RowBox[{"Timing", "[", 
       RowBox[{"Listify", "[", 
        RowBox[{"SVTExpand", ",", "tmp", ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"ListMethod", "\[Rule]", "\"\<SamePerts\>\""}], ",", 
         RowBox[{"Verbose", "\[Rule]", "True"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Time: \>\"", "<>", 
       RowBox[{"ToString", "@", "time"}], "<>", "\"\< sec. Elements: \>\"", "<>", 
       RowBox[{"ToString", "@", 
        RowBox[{"Length", "@", "EQsec6"}]}]}], "]"}], ";"}]}], 
   "\[IndentingNewLine]", "]"}], ";"}]], "Input",
