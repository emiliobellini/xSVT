      RowBox[{"tmp", "//.", 
       RowBox[{
        RowBox[{"RicciScalarCD", "[", "]"}], "\[RuleDelayed]", 
        RowBox[{"RicciScalarCDP", "[", "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tmp", "=", 
      RowBox[{"tmp", "//.", 
       RowBox[{
        RowBox[{"RicciCD", "[", 
         RowBox[{"\[Mu]_", ",", "\[Nu]_"}], "]"}], "\[RuleDelayed]", 
        RowBox[{"RicciCDP", "[", 
         RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tmp", "=", 
