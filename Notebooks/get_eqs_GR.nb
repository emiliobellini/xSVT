     RowBox[{"EQsource1", "=", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"source1", "[", 
         RowBox[{"LI", "[", "2", "]"}], "]"}]}], "-", 
       RowBox[{"Evaluate", "[", 
