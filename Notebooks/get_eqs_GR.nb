Cell[BoxData[
 RowBox[{
  RowBox[{"RunIf", "[", 
   RowBox[{
    RowBox[{"$RunFirstOrder", " ", "&&", " ", "$RunDecompositionRules"}], ",", 
    RowBox[{"{", "}"}], ",", 
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"SVTDecomposition", "[", 
      RowBox[{
       RowBox[{"ChristoffelCD", "[", 
        RowBox[{"\[Alpha]", ",", 
         RowBox[{"-", "\[Mu]"}], ",", 
         RowBox[{"-", "\[Nu]"}]}], "]"}], ",", "order", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Alpha]", "->", "a"}], ",", 
         RowBox[{"\[Mu]", "\[Rule]", "b"}], ",", 
         RowBox[{"\[Nu]", "\[Rule]", "i"}]}], "}"}], ",", 
       RowBox[{"StoreName", "\[Rule]", 
        RowBox[{"pertChristoffelCDP", "[", 
         RowBox[{
          RowBox[{"LI", "[", "order", "]"}], ",", "a", ",", 
          RowBox[{"-", "b"}], ",", 
          RowBox[{"-", "i"}]}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"tmp", "=", 
      RowBox[{
       RowBox[{"pertChristoffelCDP", "[", 
        RowBox[{
         RowBox[{"LI", "[", "order", "]"}], ",", "a", ",", 
         RowBox[{"-", "b"}], ",", 
         RowBox[{"-", "i"}]}], "]"}], " ", "//.", 
       RowBox[{"$SVTDecompositionRules", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", 
          RowBox[{"1", "+", "order"}]}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"$SVTDecompositionRules", "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", 
         RowBox[{"1", "+", "order"}]}], "]"}], "]"}], "=", 
      RowBox[{"Union", "[", 
       RowBox[{
        RowBox[{"$SVTDecompositionRules", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", 
           RowBox[{"1", "+", "order"}]}], "]"}], "]"}], ",", "\n", "\t", 
        RowBox[{"MakeRule", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"pertChristoffelCDP", "[", 
            RowBox[{
             RowBox[{"LI", "[", "order", "]"}], ",", "a", ",", 
             RowBox[{"-", "i"}], ",", 
             RowBox[{"-", "b"}]}], "]"}], ",", 
           RowBox[{"Evaluate", "[", "tmp", "]"}]}], "}"}], "]"}]}], "]"}]}], 
