Cell[BoxData[
 RowBox[{
  RowBox[{"RunIf", "[", 
   RowBox[{"$RunSecondOrder", ",", 
    RowBox[{"{", "EQsecmetric0i", "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"EQsec2", ",", "EQsource2"}], "}"}], ",", "\[IndentingNewLine]", 
    
    RowBox[{
     RowBox[{"tmp", "=", "EQsec2"}], ";", "\[IndentingNewLine]", 
     RowBox[{"EQsource2", "=", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"source2", "[", 
         RowBox[{"LI", "[", "2", "]"}], "]"}]}], "-", 
       RowBox[{"Evaluate", "[", 
        RowBox[{"tmp", "//.", 
         RowBox[{
          RowBox[{"pert_", "[", 
           RowBox[{
            RowBox[{"LI", "[", "2", "]"}], ",", "___"}], "]"}], "\[RuleDelayed]",
           "0"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"EQsec2", "=", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"source2", "[", 
         RowBox[{"LI", "[", "2", "]"}], "]"}]}], "+", 
       RowBox[{"Evaluate", "[", 
        RowBox[{"tmp", "//.", 
         RowBox[{
          RowBox[{"pert_", "[", 
           RowBox[{
            RowBox[{"LI", "[", "1", "]"}], ",", "___"}], "]"}], "\[RuleDelayed]",
           "0"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "@", 
      RowBox[{"CollectPerts", "[", 
       RowBox[{"EQsec2", ",", 
        RowBox[{"{", "}"}], ",", "Factor"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"EQsec2", "//", "Length"}], "]"}], ";", "\[IndentingNewLine]", 
