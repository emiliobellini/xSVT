Cell[BoxData[
 RowBox[{
  RowBox[{"RunIf", "[", 
   RowBox[{"$RunSecondOrder", ",", 
    RowBox[{"{", "EQsecmetricij", "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"EQsec6", ",", "EQsec7", ",", "EQsource6", ",", "EQsource7"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time", ",", "tmp"}], "}"}], "=", 
      RowBox[{"Timing", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"PD", "[", 
            RowBox[{"-", "m"}], "]"}], "@", "#"}], " ", "&"}], ",", 
         "tmpijkl"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Time: \>\"", "<>", 
       RowBox[{"ToString", "@", "time"}], "<>", "\"\< sec. Elements: \>\"", "<>", 
       RowBox[{"ToString", "@", 
        RowBox[{"Length", "@", "tmp"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time", ",", "tmpijklm"}], "}"}], "=", 
      RowBox[{"Timing", "[", 
       RowBox[{"Listify", "[", 
        RowBox[{"SVTExpand", ",", "tmp", ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"ListMethod", "\[Rule]", "\"\<SamePerts\>\""}], ",", 
         RowBox[{"Verbose", "\[Rule]", "True"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Time: \>\"", "<>", 
       RowBox[{"ToString", "@", "time"}], "<>", "\"\< sec. Elements: \>\"", "<>", 
