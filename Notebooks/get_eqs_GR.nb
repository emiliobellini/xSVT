Cell[BoxData[
 RowBox[{
  RowBox[{"RunIf", "[", 
   RowBox[{"$RunSecondOrder", ",", 
    RowBox[{"{", "EQsecmetricij", "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"EQsec6", ",", "EQsec7", ",", "EQsource6", ",", "EQsource7"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time", ",", "tmp"}], "}"}], "=", 
      RowBox[{"Timing", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"metric\[Delta]", "[", 
            RowBox[{"j", ",", "k"}], "]"}], " ", 
           RowBox[{"metric\[Delta]", "[", 
            RowBox[{"l", ",", "m"}], "]"}], " ", "#"}], " ", "&"}], ",", 
         "tmpijklm"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
