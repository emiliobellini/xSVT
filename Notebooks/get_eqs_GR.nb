 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{"runEQsec10", ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time", ",", "tmp"}], "}"}], "=", 
      RowBox[{"Timing", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"PD", "[", 
            RowBox[{"-", "k"}], "]"}], "@", "#"}], " ", "&"}], ",", "tmpij"}],
         "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
