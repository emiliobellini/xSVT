 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"runEQthird7", " ", "&&", " ", 
     RowBox[{"Not", "@", 
      RowBox[{"ValueQ", "@", "laplaptrace"}]}]}], ",", "\[IndentingNewLine]", 
    
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time", ",", "tmp"}], "}"}], "=", 
      RowBox[{"Timing", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"metric\[Delta]", "[", 
            RowBox[{"i", ",", "j"}], "]"}], " ", 
