          RowBox[{"-", "\[Alpha]"}], ",", 
          RowBox[{"-", "\[Mu]"}], ",", 
          RowBox[{"-", "\[Beta]"}], ",", 
          RowBox[{"-", "\[Nu]"}]}], "]"}]}], ",", "order", ",", 
       RowBox[{"{", 
