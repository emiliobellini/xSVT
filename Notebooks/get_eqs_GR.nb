        RowBox[{"tmp", "//.", 
         RowBox[{
          RowBox[{"pert_", "[", 
           RowBox[{
            RowBox[{"LI", "[", "1", "]"}], ",", "___"}], "]"}], 
          "\[RuleDelayed]", "0"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
