Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{"runEQgaugethirdHij", ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time", ",", "tmp"}], "}"}], "=", 
      RowBox[{"Timing", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"metric\[Delta]", "[", 
            RowBox[{"k", ",", "l"}], "]"}], " ", 
           RowBox[{"metric\[Delta]", "[", 
            RowBox[{"m", ",", "n"}], "]"}], " ", 
           RowBox[{"#", "/", 
            RowBox[{
             RowBox[{"scale", "[", "]"}], "^", "2"}]}]}], " ", "&"}], ",", 
         "tmpijklmn"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Time: \>\"", "<>", 
