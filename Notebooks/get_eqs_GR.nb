Cell[BoxData[
 RowBox[{
  RowBox[{"RunIf", "[", 
   RowBox[{"$RunSecondOrder", ",", 
    RowBox[{"{", 
     RowBox[{"EQsecmatteri", ",", "EQsec9"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"EQsec10", ",", "EQsource10"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time", ",", "tmp1"}], "}"}], "=", 
      RowBox[{"Timing", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"metric\[Delta]", "[", 
            RowBox[{"j", ",", "k"}], "]"}], " ", "#"}], " ", "&"}], ",", 
         "tmpijk"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Time: \>\"", "<>", 
       RowBox[{"ToString", "@", "time"}], "<>", "\"\< sec. Elements: \>\"", "<>", 
       RowBox[{"ToString", "@", 
        RowBox[{"Length", "@", "tmp1"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time", ",", "tmp2"}], "}"}], "=", 
      RowBox[{"Timing", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{
            RowBox[{"PD", "[", 
             RowBox[{"-", "i"}], "]"}], "@", "#"}]}], " ", "&"}], ",", 
         "EQsec9"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Time: \>\"", "<>", 
       RowBox[{"ToString", "@", "time"}], "<>", "\"\< sec. Elements: \>\"", "<>", 
       RowBox[{"ToString", "@", 
        RowBox[{"Length", "@", "tmp2"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time", ",", "tmp"}], "}"}], "=", 
      RowBox[{"Timing", "[", 
       RowBox[{"Listify", "[", 
        RowBox[{"Expand", ",", 
         RowBox[{"tmp1", "+", "tmp2"}], ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"ListMethod", "\[Rule]", "\"\<SamePerts\>\""}], ",", 
         RowBox[{"Verbose", "\[Rule]", "True"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Time: \>\"", "<>", 
       RowBox[{"ToString", "@", "time"}], "<>", "\"\< sec. Elements: \>\"", "<>", 
       RowBox[{"ToString", "@", 
        RowBox[{"Length", "@", "tmp"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time", ",", "EQsec10"}], "}"}], "=", 
      RowBox[{"Timing", "[", 
       RowBox[{"Listify", "[", 
        RowBox[{"SVTExpand", ",", "tmp", ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"ListMethod", "\[Rule]", "\"\<SamePerts\>\""}], ",", 
         RowBox[{"Verbose", "\[Rule]", "True"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Time: \>\"", "<>", 
       RowBox[{"ToString", "@", "time"}], "<>", "\"\< sec. Elements: \>\"", "<>", 
