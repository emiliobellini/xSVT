Cell[BoxData[
 RowBox[{
  RowBox[{"RunIf", "[", 
   RowBox[{
    RowBox[{"$RunFirstOrder", " ", "&&", " ", "$RunDecompositionRules"}], ",", 
    RowBox[{"{", "}"}], ",", 
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"SVTDecomposition", "[", 
      RowBox[{
       RowBox[{"RiemannCD", "[", 
        RowBox[{
         RowBox[{"-", "\[Mu]"}], ",", 
         RowBox[{"-", "\[Nu]"}], ",", 
         RowBox[{"-", "\[Alpha]"}], ",", 
         RowBox[{"-", "\[Beta]"}]}], "]"}], ",", "order", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Mu]", "->", "a"}], ",", 
         RowBox[{"\[Nu]", "->", "i"}], ",", 
         RowBox[{"\[Alpha]", "->", "j"}], ",", 
         RowBox[{"\[Beta]", "->", "k"}]}], "}"}], ",", 
       RowBox[{"StoreName", "\[Rule]", 
        RowBox[{"pertRiemannCDP", "[", 
         RowBox[{
          RowBox[{"LI", "[", "order", "]"}], ",", 
          RowBox[{"-", "a"}], ",", 
          RowBox[{"-", "i"}], ",", 
          RowBox[{"-", "j"}], ",", 
          RowBox[{"-", "k"}]}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"tmp", "=", 
      RowBox[{
       RowBox[{"pertRiemannCDP", "[", 
        RowBox[{
         RowBox[{"LI", "[", "order", "]"}], ",", 
         RowBox[{"-", "a"}], ",", 
         RowBox[{"-", "i"}], ",", 
         RowBox[{"-", "j"}], ",", 
         RowBox[{"-", "k"}]}], "]"}], " ", "//.", 
       RowBox[{"$SVTDecompositionRules", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", 
          RowBox[{"1", "+", "order"}]}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"$SVTDecompositionRules", "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", 
         RowBox[{"1", "+", "order"}]}], "]"}], "]"}], "=", 
      RowBox[{"Union", "[", 
       RowBox[{
        RowBox[{"$SVTDecompositionRules", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", 
           RowBox[{"1", "+", "order"}]}], "]"}], "]"}], ",", "\n", "\t", 
        RowBox[{"MakeRule", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"pertRiemannCDP", "[", 
            RowBox[{
             RowBox[{"LI", "[", "order", "]"}], ",", 
             RowBox[{"-", "i"}], ",", 
             RowBox[{"-", "a"}], ",", 
             RowBox[{"-", "j"}], ",", 
             RowBox[{"-", "k"}]}], "]"}], ",", 
           RowBox[{"Evaluate", "[", 
            RowBox[{"-", "tmp"}], "]"}]}], "}"}], "]"}], ",", "\n", "\t", 
        RowBox[{"MakeRule", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"pertRiemannCDP", "[", 
            RowBox[{
             RowBox[{"LI", "[", "order", "]"}], ",", 
             RowBox[{"-", "j"}], ",", 
             RowBox[{"-", "k"}], ",", 
             RowBox[{"-", "a"}], ",", 
             RowBox[{"-", "i"}]}], "]"}], ",", 
           RowBox[{"Evaluate", "[", "tmp", "]"}]}], "}"}], "]"}], ",", "\n", 
        "\t", 
        RowBox[{"MakeRule", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"pertRiemannCDP", "[", 
            RowBox[{
             RowBox[{"LI", "[", "order", "]"}], ",", 
             RowBox[{"-", "j"}], ",", 
             RowBox[{"-", "k"}], ",", 
             RowBox[{"-", "i"}], ",", 
             RowBox[{"-", "a"}]}], "]"}], ",", 
           RowBox[{"Evaluate", "[", 
            RowBox[{"-", "tmp"}], "]"}]}], "}"}], "]"}]}], "]"}]}], ";"}]}], 
   "\[IndentingNewLine]", "]"}], ";"}]], "Input",
