Cell[BoxData[
 RowBox[{
  RowBox[{"RunIf", "[", 
   RowBox[{
    RowBox[{"$RunFirstOrder", " ", "&&", " ", "$RunDecompositionRules"}], ",", 
    RowBox[{"{", "}"}], ",", 
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"SVTDecomposition", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"metricg", "[", 
         RowBox[{"\[Alpha]", ",", "\[Beta]"}], "]"}], " ", 
        RowBox[{"RiemannCDP", "[", 
         RowBox[{
          RowBox[{"-", "\[Alpha]"}], ",", 
          RowBox[{"-", "\[Mu]"}], ",", 
          RowBox[{"-", "\[Beta]"}], ",", 
          RowBox[{"-", "\[Nu]"}]}], "]"}]}], ",", "order", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Mu]", "->", "a"}], ",", 
         RowBox[{"\[Nu]", "\[Rule]", "i"}]}], "}"}], ",", 
       RowBox[{"StoreName", "\[Rule]", 
        RowBox[{"pertRicciCDP", "[", 
         RowBox[{
          RowBox[{"LI", "[", "order", "]"}], ",", 
          RowBox[{"-", "a"}], ",", 
          RowBox[{"-", "i"}]}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"tmp", "=", 
      RowBox[{
       RowBox[{"pertRicciCDP", "[", 
        RowBox[{
         RowBox[{"LI", "[", "order", "]"}], ",", 
         RowBox[{"-", "a"}], ",", 
         RowBox[{"-", "i"}]}], "]"}], " ", "//.", 
       RowBox[{"$SVTDecompositionRules", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", 
          RowBox[{"1", "+", "order"}]}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"$SVTDecompositionRules", "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", 
         RowBox[{"1", "+", "order"}]}], "]"}], "]"}], "=", 
      RowBox[{"Union", "[", 
       RowBox[{
        RowBox[{"$SVTDecompositionRules", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", 
           RowBox[{"1", "+", "order"}]}], "]"}], "]"}], ",", "\n", "\t", 
        RowBox[{"MakeRule", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"pertRicciCDP", "[", 
            RowBox[{
             RowBox[{"LI", "[", "order", "]"}], ",", 
             RowBox[{"-", "i"}], ",", 
             RowBox[{"-", "a"}]}], "]"}], ",", 
           RowBox[{"Evaluate", "[", "tmp", "]"}]}], "}"}], "]"}]}], "]"}]}], 
