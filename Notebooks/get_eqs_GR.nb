Cell[BoxData[
 RowBox[{
  RowBox[{"RunIf", "[", 
   RowBox[{"$RunSecondOrder", ",", 
    RowBox[{"{", "EQsecmatteri", "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"EQsec9", ",", "EQsource9"}], "}"}], ",", "\[IndentingNewLine]", 
    
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time", ",", "tmp"}], "}"}], "=", 
      RowBox[{"Timing", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"metric\[Delta]", "[", 
            RowBox[{"i", ",", "j"}], "]"}], "#"}], " ", "&"}], ",", "tmpij"}],
         "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Time: \>\"", "<>", 
       RowBox[{"ToString", "@", "time"}], "<>", "\"\< sec. Elements: \>\"", "<>", 
       RowBox[{"ToString", "@", 
        RowBox[{"Length", "@", "tmp"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time", ",", "EQsec9"}], "}"}], "=", 
      RowBox[{"Timing", "[", 
       RowBox[{"Listify", "[", 
        RowBox[{"SVTExpand", ",", "tmp", ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"ListMethod", "\[Rule]", "\"\<SamePerts\>\""}], ",", 
         RowBox[{"Verbose", "\[Rule]", "True"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Time: \>\"", "<>", 
       RowBox[{"ToString", "@", "time"}], "<>", "\"\< sec. Elements: \>\"", "<>", 
       RowBox[{"ToString", "@", 
        RowBox[{"Length", "@", "EQsec9"}]}]}], "]"}], ";"}]}], 
   "\[IndentingNewLine]", "]"}], ";"}]], "Input",
