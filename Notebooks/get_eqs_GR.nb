           RowBox[{
            RowBox[{"PD", "[", 
             RowBox[{"-", "n"}], "]"}], "@", 
            RowBox[{
             RowBox[{"PD", "[", 
              RowBox[{"-", "m"}], "]"}], "@", "#"}]}]}], " ", "&"}], ",", 
         "tmpijkl"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
