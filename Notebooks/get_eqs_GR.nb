  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"runEQthird2", " ", "||", " ", "runEQthird5"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time", ",", "tmp"}], "}"}], "=", 
      RowBox[{"Timing", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"PD", "[", 
            RowBox[{"-", "j"}], "]"}], "@", "#"}], " ", "&"}], ",", "tmpi"}], 
