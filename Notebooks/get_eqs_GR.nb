Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"RunIf", "[", 
   RowBox[{
    RowBox[{"$RunSecondOrder", " ", "&&", " ", "$RunDecompositionRules"}], ",", 
    RowBox[{"{", "}"}], ",", 
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"SVTDecomposition", "[", 
      RowBox[{
       RowBox[{"ChristoffelCD", "[", 
        RowBox[{"\[Alpha]", ",", 
         RowBox[{"-", "\[Mu]"}], ",", 
         RowBox[{"-", "\[Nu]"}]}], "]"}], ",", "order", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Alpha]", "\[Rule]", "i"}], ",", 
         RowBox[{"\[Mu]", "\[Rule]", "a"}], ",", 
         RowBox[{"\[Nu]", "\[Rule]", "j"}]}], "}"}], ",", 
       RowBox[{"StoreName", "\[Rule]", 
        RowBox[{"pertChristoffelCDP", "[", 
         RowBox[{
          RowBox[{"LI", "[", "order", "]"}], ",", "i", ",", 
          RowBox[{"-", "a"}], ",", 
          RowBox[{"-", "j"}]}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"tmp", "=", 
      RowBox[{
       RowBox[{"pertChristoffelCDP", "[", 
        RowBox[{
         RowBox[{"LI", "[", "order", "]"}], ",", "i", ",", 
         RowBox[{"-", "a"}], ",", 
         RowBox[{"-", "j"}]}], "]"}], " ", "//.", 
       RowBox[{"$SVTDecompositionRules", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", 
          RowBox[{"1", "+", "order"}]}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"$SVTDecompositionRules", "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", 
         RowBox[{"1", "+", "order"}]}], "]"}], "]"}], "=", 
      RowBox[{"Union", "[", 
       RowBox[{
        RowBox[{"$SVTDecompositionRules", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", 
           RowBox[{"1", "+", "order"}]}], "]"}], "]"}], ",", "\n", "\t", 
        RowBox[{"MakeRule", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"pertChristoffelCDP", "[", 
            RowBox[{
             RowBox[{"LI", "[", "order", "]"}], ",", "i", ",", 
             RowBox[{"-", "j"}], ",", 
             RowBox[{"-", "a"}]}], "]"}], ",", 
           RowBox[{"Evaluate", "[", "tmp", "]"}]}], "}"}], "]"}]}], "]"}]}], 
     ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]], "Input",
