 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{"runEQsec7", ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time", ",", "tmp"}], "}"}], "=", 
      RowBox[{"Timing", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"PD", "[", 
            RowBox[{"-", "i"}], "]"}], "@", 
           RowBox[{
            RowBox[{"PD", "[", 
             RowBox[{"-", "j"}], "]"}], "@", "#"}]}], " ", "&"}], ",", 
