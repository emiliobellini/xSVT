 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{"runEQthird5", ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time", ",", "tmp1"}], "}"}], "=", 
      RowBox[{"Timing", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"metric\[Delta]", "[", 
            RowBox[{"j", ",", "k"}], "]"}], " ", "#"}], " ", "&"}], ",", 
         "tmpijk"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
