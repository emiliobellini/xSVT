 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{"runEQgaugethirdSi", ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time", ",", "tmp"}], "}"}], "=", 
      RowBox[{"Timing", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"PD", "[", 
            RowBox[{"-", "i"}], "]"}], "@", "#"}], " ", "&"}], ",", "tmp2"}], 
        "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
