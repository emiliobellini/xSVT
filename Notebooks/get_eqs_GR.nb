Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"runEQthird7", " ", "&&", " ", 
     RowBox[{"Not", "@", 
      RowBox[{"ValueQ", "@", "lapdivdiv"}]}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time", ",", "tmp"}], "}"}], "=", 
      RowBox[{"Timing", "[", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"metric\[Delta]", "[", 
            RowBox[{"i", ",", "k"}], "]"}], " ", 
           RowBox[{"metric\[Delta]", "[", 
            RowBox[{"j", ",", "l"}], "]"}], " ", 
           RowBox[{"metric\[Delta]", "[", 
            RowBox[{"m", ",", "n"}], "]"}], " ", 
           RowBox[{
            RowBox[{"PD", "[", 
             RowBox[{"-", "n"}], "]"}], "@", 
            RowBox[{
             RowBox[{"PD", "[", 
              RowBox[{"-", "m"}], "]"}], "@", "#"}]}]}], " ", "&"}], ",", 
         "tmpijkl"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
