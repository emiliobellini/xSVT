Cell[BoxData["\<\"(-1.)*rho_smg + (-1.)/3.*G2 + pow(H_b,2) + \
(-2.)*G4*pow(H_b,2) + 2./3.*X*G2_X + \
(-1.)*pow(G4,-1)*H_b*phi_b_prime_prime_over_b2*phi_b_prime_over_b*G4_X + \
(-1.)*G2*pow(G4,-1)*X*G4_X + 2.*pow(H_b,2)*X*G4_X + \
2.*pow(G4,-1)*pow(H_b,2)*X*G4_X + (-3.)*pow(G4,-1)*p_tot*X*G4_X + \
1./2.*pow(G4,-2)*pow(phi_b_prime_prime_over_b2,2)*X*pow(G4_X,2) + \
(-1.)*pow(G4,-2)*H_b*phi_b_prime_prime_over_b2*phi_b_prime_over_b*X*pow(G4_X,\
2) + pow(G4,-2)*pow(H_b,2)*pow(X,2)*pow(G4_X,2) + \
(-1.)*pow(G4,-1)*H_b*phi_b_prime_over_b*G4_phi + \
pow(G4,-2)*phi_b_prime_prime_over_b2*X*G4_X*G4_phi + \
(-1.)*pow(G4,-2)*H_b*phi_b_prime_over_b*X*G4_X*G4_phi + \
(-6.)*pow(G4,-1)*H_b*phi_b_prime_over_b*X*G4_X*G4_phi + \
1./2.*pow(G4,-2)*X*pow(G4_phi,2) + pow(G4,-1)*X*pow(G4_phi,2) + \
5.*pow(G4,-2)*pow(X,2)*G4_X*pow(G4_phi,2) + \
(-4.)*pow(G4,-1)*pow(X,2)*G4_X*G4_phiphi;\"\>"], "Output",
