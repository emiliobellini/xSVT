Cell[BoxData["\<\"l4 = G4*G2_X + 3./2.*rho_tot*G4_X + (-2.)*G2*G4_X + \
(-9.)/2.*p_tot*G4_X + (-5.)*X*G2_X*G4_X + \
(-6.)*rho_r*pow(G4,-1)*X*pow(G4_X,2) + 6.*G2*pow(G4,-1)*X*pow(G4_X,2) + \
18.*pow(G4,-1)*p_tot*X*pow(G4_X,2) + 2.*G4*X*G2_XX + (-3.)*G2*X*G4_XX + \
6.*G4*pow(H_b,2)*X*G4_XX + (-9.)*p_tot*X*G4_XX + \
(-18.)*H_b*phi_b_prime_over_b*G4_X*G4_phi + \
18.*pow(G4,-1)*H_b*phi_b_prime_over_b*X*pow(G4_X,2)*G4_phi + \
(-18.)*H_b*phi_b_prime_over_b*X*G4_XX*G4_phi + 3.*pow(G4_phi,2) + \
24.*pow(G4,-1)*X*G4_X*pow(G4_phi,2) + \
(-18.)*pow(G4,-2)*pow(X,2)*pow(G4_X,2)*pow(G4_phi,2) + \
15.*pow(G4,-1)*pow(X,2)*G4_XX*pow(G4_phi,2) + \
(-18.)*H_b*phi_b_prime_over_b*X*G4_X*G4_Xphi + 6.*X*G4_phi*G4_Xphi + \
30.*pow(G4,-1)*pow(X,2)*G4_X*G4_phi*G4_Xphi + (-24.)*X*G4_X*G4_phiphi + \
24.*pow(G4,-1)*pow(X,2)*pow(G4_X,2)*G4_phiphi + \
(-12.)*pow(X,2)*G4_XX*G4_phiphi + (-12.)*pow(X,2)*G4_X*G4_Xphiphi;\"\>"], \
