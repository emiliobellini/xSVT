Cell["Additional definitions", "Subsection",
 CellChangeTimes->{{3.977826506402458*^9, 
  3.977826510047727*^9}},ExpressionUUID->"4ea0503a-3025-49cf-9bf5-\
0f2f1e5fb134"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SubX0B", "=", 
   RowBox[{"MakeRule", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"XB", "[", "]"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"primescalarB", "[", "]"}], "^", "2"}], "/", "2"}], "/", 
       RowBox[{
        RowBox[{"scaleB", "[", "]"}], "^", "2"}]}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"restoreXinGB", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Derivative", "[", 
         RowBox[{"n_", ",", "m_"}], "]"}], "[", "Gfun_", "]"}], "[", 
       RowBox[{
        RowBox[{"scalarB", "[", "]"}], ",", "x_"}], "]"}], ":>", 
      RowBox[{
       RowBox[{
        RowBox[{"Derivative", "[", 
         RowBox[{"n", ",", "m"}], "]"}], "[", "Gfun", "]"}], "[", 
       RowBox[{
        RowBox[{"scalarB", "[", "]"}], ",", 
        RowBox[{"XB", "[", "]"}]}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"Gfun_", "[", 
       RowBox[{
        RowBox[{"scalarB", "[", "]"}], ",", "x_"}], "]"}], ":>", 
      RowBox[{"Gfun", "[", 
       RowBox[{
        RowBox[{"scalarB", "[", "]"}], ",", 
        RowBox[{"XB", "[", "]"}]}], "]"}]}]}], "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.97790686690232*^9, 3.977906912933221*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"591c13f3-6654-4d40-9ccb-8c6b1552b249"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TimeDerBG", "[", "expr_", "]"}], ":=", 
  RowBox[{
   RowBox[{"TimeDerB", "[", 
    RowBox[{"expr", " ", "//.", "SubX0B"}], "]"}], " ", "//.", 
   "restoreXinGB"}]}]], "Input",
