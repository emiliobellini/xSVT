Cell[BoxData["\<\"ppw->pvecmetric[ppw->index_mt_rsa_p_smg] = \
pow(cD,2)*pow(H,2)*pow(6.*pow(cD,2)*rho_r + \
(-1.)*c7*pow(H,2),-1)*k2H*ppw->rho_plus_p_shear + \
(-1.)*pow(cD,2)*pow(H,2)*pow(6.*pow(cD,2)*rho_r + \
