Cell[BoxData["\<\"c5 = \
(-1.)*pow(G4,-1)*pvecback[pba->index_bg_phi_prime_prime_smg]*pow(a,-2)*G4_X + \
(-3.)*pow(G4,-1)*H*phi_prime*pow(a,-1)*G4_X + \
pow(G4,-2)*pvecback[pba->index_bg_phi_prime_prime_smg]*pow(a,-2)*X*pow(G4_X,2)\
 + (-1.)*pow(G4,-2)*H*phi_prime*pow(a,-1)*X*pow(G4_X,2) + \
(-2.)*pow(G4,-1)*pvecback[pba->index_bg_phi_prime_prime_smg]*pow(a,-2)*X*G4_\
XX + 2.*pow(G4,-1)*H*phi_prime*pow(a,-1)*X*G4_XX + pow(G4,-1)*G4_phi + \
