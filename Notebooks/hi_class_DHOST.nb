Cell[BoxData["\<\"ppw->pvecmetric[ppw->index_mt_x_prime_prime_smg] = \
(-3.)*cD*H*pow(6.*pow(cD,2)*rho_r + \
(-1.)*c7*pow(H,2),-1)*ppw->rho_plus_p_theta*a + \
3.*cD*H*pow(6.*pow(cD,2)*rho_r + \
(-1.)*c7*pow(H,2),-1)*ppw->rho_plus_p_theta_r*a + (2.*cD*rho_r + \
c6*pow(H,2))*H*pow(6.*pow(cD,2)*rho_r + (-1.)*c7*pow(H,2),-1)*perth_b_prime*a \
+ (c8 + (-4.)*c4*cD*k2H)*(-1.)*pow(H,3)*pow((-6.)*pow(cD,2)*rho_r + \
