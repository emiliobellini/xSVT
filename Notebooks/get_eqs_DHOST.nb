      RowBox[{"SeparateMetric", "[", "]"}]}], " ", "//", " ", "ToCanonical"}],
     " ", "//", " ", "ReplaceDummies"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tmp", " ", "=", " ", 
   RowBox[{"tmp", " ", "//.", 
    RowBox[{"Flatten", "@", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"EQDHOSTdegeneracy", "==", "0"}], " ", "//.", 
         RowBox[{
          RowBox[{"scalar", "[", "]"}], ":>", 
          RowBox[{"scalarcov", "[", "]"}]}]}], " ", "//.", 
        RowBox[{
         RowBox[{"X", "[", "]"}], ":>", 
         RowBox[{"Xcov", "[", "]"}]}]}], ",", 
       RowBox[{"A4fun", "[", 
        RowBox[{
         RowBox[{"scalarcov", "[", "]"}], ",", 
         RowBox[{"Xcov", "[", "]"}]}], "]"}]}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "@", 
   RowBox[{"ScreenDollarIndices", "@", "tmp"}]}], ";"}], "\[IndentingNewLine]", 
