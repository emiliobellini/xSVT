Cell[CellGroupData[{

Cell["Covariant Equations of Motion", "Section",
 CellChangeTimes->{{3.759754755776483*^9, 
  3.759754763009345*^9}},ExpressionUUID->"7c2409ef-5eb3-41cd-ba30-\
30a6f022b4c5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RunIf", "[", 
  RowBox[{"$RunCovariant", ",", 
   RowBox[{"{", 
    RowBox[{"Lgravity", ",", "Lmatter"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"EQcovmetric", ",", "EQcovscalar", ",", "EQcovmatter"}], "}"}], ",",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tmp", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Lgravity", "+", "Lmatter"}], " ", "//", " ", 
        RowBox[{"SeparateMetric", "[", "]"}]}], " ", "//", " ", 
       "ToCanonical"}], " ", "//", " ", "ReplaceDummies"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"tmp", " ", "=", " ", 
     RowBox[{"tmp", " ", "//.", 
      RowBox[{"Flatten", "@", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"EQDHOSTdegeneracy", "==", "0"}], " ", "//.", 
           RowBox[{
            RowBox[{"scalar", "[", "]"}], ":>", 
            RowBox[{"scalarcov", "[", "]"}]}]}], " ", "//.", 
          RowBox[{
           RowBox[{"X", "[", "]"}], ":>", 
           RowBox[{"Xcov", "[", "]"}]}]}], ",", 
         RowBox[{"A4fun", "[", 
          RowBox[{
           RowBox[{"scalarcov", "[", "]"}], ",", 
           RowBox[{"Xcov", "[", "]"}]}], "]"}]}], "]"}]}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "@", 
     RowBox[{"ScreenDollarIndices", "@", "tmp"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"tmpL", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"ExpandPerturbation", "[", 
         RowBox[{"Perturbation", "[", 
          RowBox[{
           RowBox[{"tmp", " ", "//", " ", "XcovToScalarcov"}], ",", "1"}], 
          "]"}], "]"}], " ", "//", " ", "ScalarcovToXcov"}], " ", "//", " ", 
       "NoScalar"}], " ", "//", " ", "ToCanonical"}]}], ";"}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{
  3.81902485108132*^9, {3.894860582203979*^9, 3.8948605875555067`*^9}, {
   3.894967405999996*^9, 3.894967409383827*^9}, {3.895631434584154*^9, 
